From 7d52b07eff6d9e07d90da996271a27ca99331e40 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Alexander=20=C3=85strand?= <alexander.astrand@gmail.com>
Date: Sat, 31 Oct 2026 09:30:12 +0100
Subject: [PATCH 1/9] H5: a glob under a $var folder is judged by its last part
 (kit 1.8)

mayBeScripts tested the whole folder for $ or a backtick, so `for d in $r/.claude/worktrees/*/; do wc -l "$d"x; done` was refused as the arm script. Now only the last part decides; the head may hold plain $name or ${name} only, and a .. keeps the old rule. The lens's seven probe shapes and five refusals are in guard-reads.test.mjs.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plugins/database/hooks/guard-production.mjs | 14 +++++++++-
 plugins/database/hooks/guard-reads.test.mjs | 29 +++++++++++++++++++++
 2 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/plugins/database/hooks/guard-production.mjs b/plugins/database/hooks/guard-production.mjs
index 28aa372..e3bff4a 100644
--- a/plugins/database/hooks/guard-production.mjs
+++ b/plugins/database/hooks/guard-production.mjs
@@ -2669,8 +2669,20 @@ function scriptGlob(token, where, pattern) {
 
 // A folder is scripts/ when its last part is (or globs to) that name; one
 // built at run time, or relative to a folder that isn't known, may be.
+// Kit 1.8 (H5): only the last part decides. `$r/.claude/worktrees` is not
+// scripts/ whatever $r holds, so a read-only loop over worktrees passes;
+// `$r/scripts` and `$d` (last part built at run time) still may be. A folder
+// with no `/` keeps the old rule: all of it is the last part. The parts
+// before it may hold only plain `$name` or `${name}`: a substitution or
+// `${r:-x/scripts}` can carry a `/` of its own, and a `..` can climb back
+// into $r, so either keeps the old rule too.
 function mayBeScripts(folder, where) {
-  if (/[$`]/.test(folder)) return true
+  if (/[$`]/.test(folder)) {
+    const parts = folder.split('/')
+    const last = parts.pop()
+    const head = parts.join('/').replace(/\$(?:[A-Za-z_]\w*|\{[A-Za-z_]\w*\})/g, '')
+    if (!parts.length || /[$`]/.test(last) || /[$`]/.test(head) || ['', '.', '..'].includes(last) || parts.includes('..')) return true
+  }
   let path = folder.replace(/^~(?=\/|$)/, homedir())
   if (!isAbsolute(path)) {
     if (where?.built) return true
diff --git a/plugins/database/hooks/guard-reads.test.mjs b/plugins/database/hooks/guard-reads.test.mjs
index f559415..33d130b 100644
--- a/plugins/database/hooks/guard-reads.test.mjs
+++ b/plugins/database/hooks/guard-reads.test.mjs
@@ -194,6 +194,35 @@ describe('H5: the shapes that stay off the list', () => {
   })
 })
 
+// Kit 1.8 (the kit 1.7.1 council's H5): the database lens's seven probe
+// shapes. A `$var` before a known last part (`worktrees`) is not scripts/,
+// so the navigator's read-only loops pass; a last part built at run time,
+// or `scripts` itself, still counts as the arm script's folder.
+describe('H5 (kit 1.8): a glob under a $var folder judged by its last part', () => {
+  const wt = `${root}/.claude/worktrees`
+  it.each([
+    [`ls ${wt}/*/`, 'pass'],
+    [`for d in ${wt}/*/; do ls "$d"; done`, 'pass'],
+    [`r=${root}; ls $r/.claude/worktrees/*/`, 'pass'],
+    [`r=${root}; for d in $r/.claude/worktrees/*/; do wc -l "$d"x; done`, 'pass'],
+    [`r=${root}; for d in $r/.claude/worktrees/*; do ls $d; done`, 'pass'],
+    [`r=${root}; for d in "$r"/.claude/worktrees/*/; do ls "$d"; done`, 'pass'],
+    [`for d in ${wt}/*/; do echo "$d"; done`, 'pass'],
+  ])('probe: %s gets %s', (cmd, verdict) => {
+    expect(d(cmd)).toBe(verdict)
+  })
+
+  it.each([
+    `r=${root}; for f in $r/scripts/*; do bash $f; done`,
+    `for d in ${wt}/*/; do for f in $d/*; do sh $f; done; done`,
+    'for f in ${r:-x/scripts}/*; do bash $f; done',
+    'for f in $r/x/../*; do bash $f; done',
+    'for f in $(echo scripts | tr x y)/*; do bash $f; done',
+  ])('%s stays refused', (cmd) => {
+    expect(d(cmd)).toBe('deny')
+  })
+})
+
 describe('M10: a regex in node code is not a release command', () => {
   it('a `gh (a|b)` group stays refused (zsh globs it), and the deny says to run the code from a file', () => {
     const r = call(`node -e 'const kinds = [/gh (run|pr) list/, /git show/]; console.log(kinds)'`)
