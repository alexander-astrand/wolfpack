Subject: [PATCH 8/9] M12 fix: a resumed session's allows count once (kit 1.8)

Review round 1, nit 2: a resumed session ends again and writes another allows row; guardTotals summed them all. Its transcript and log rows run on from the first, so the last row per session id holds the whole session and the earlier ones are dropped. Test added.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plugins/database/hooks/denied-log.mjs      | 14 +++++++++-----
 plugins/database/hooks/denied-log.test.mjs | 10 ++++++++++
 2 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/plugins/database/hooks/denied-log.mjs b/plugins/database/hooks/denied-log.mjs
index 7c22459..6acf7f7 100644
--- a/plugins/database/hooks/denied-log.mjs
+++ b/plugins/database/hooks/denied-log.mjs
@@ -389,16 +389,20 @@ export function guardReasons(guard = '', since) {
 export function guardTotals(guard = '', since) {
   const from = since ? Date.parse(since) : -Infinity
   const t = { sessions: 0, calls: 0, asks: 0, denies: 0, through: 0, asides: 0 }
+  // A resumed session ends again and writes another row; its transcript and
+  // its log rows run on from the first, so the last row holds the whole
+  // session and the earlier ones are dropped (review round 1, nit 2).
+  const last = new Map()
   for (const line of guard.split('\n')) {
     const f = line.split('\t')
     if (f.length < 8 || !(Date.parse(f[0]) >= from)) continue
     if (f[7] === 'step-aside') t.asides++
     if (f[7] !== 'allows') continue
-    try {
-      const c = JSON.parse(f[3])
-      t.sessions++
-      for (const k of ['calls', 'asks', 'denies', 'through']) t[k] += Number(c[k]) || 0
-    } catch { /* a cut row */ }
+    try { last.set(f[5], JSON.parse(f[3])) } catch { /* a cut row */ }
+  }
+  for (const c of last.values()) {
+    t.sessions++
+    for (const k of ['calls', 'asks', 'denies', 'through']) t[k] += Number(c[k]) || 0
   }
   return t
 }
diff --git a/plugins/database/hooks/denied-log.test.mjs b/plugins/database/hooks/denied-log.test.mjs
index 9b16bca..a64567f 100644
--- a/plugins/database/hooks/denied-log.test.mjs
+++ b/plugins/database/hooks/denied-log.test.mjs
@@ -300,6 +300,16 @@ describe('M12 (kit 1.8): reason codes, allows and the step-aside', () => {
     expect(text).not.toMatch(/SessionEnd/)
   })
 
+  it('a resumed session that ends twice counts once, by its last allows row', () => {
+    const allows = (sid, c) => ['2026-10-30T10:00:00.000Z', 'main', 'SessionEnd', JSON.stringify(c), 'auto', sid, '-', 'allows', 'x', 'session-allows'].join('\t')
+    const guard = [
+      allows('s1', { calls: 10, asks: 1, denies: 0, through: 9 }),
+      allows('s2', { calls: 5, asks: 0, denies: 1, through: 4 }),
+      allows('s1', { calls: 25, asks: 2, denies: 1, through: 22 }),
+    ].join('\n')
+    expect(guardTotals(guard)).toEqual({ sessions: 2, calls: 30, asks: 2, denies: 2, through: 26, asides: 0 })
+  })
+
   it('hooks.json runs guard-allows.mjs at SessionEnd, which writes the row as a process', () => {
     const hooks = JSON.parse(readFileSync(fileURLToPath(new URL('./hooks.json', import.meta.url)), 'utf8'))
     expect(hooks.hooks.SessionEnd[0].hooks[0].command).toMatch(/hooks\/guard-allows\.mjs"$/)
